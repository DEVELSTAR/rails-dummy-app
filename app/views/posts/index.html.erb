<div class="max-w-6xl mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold text-gray-900">Posts</h1>
    <%= link_to 'New Post', new_post_path, class: "bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition-colors" %>
  </div>

  <% if @posts.any? %>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      <% @posts.each do |post| %>
        <div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow">
          <h2 class="text-xl font-semibold text-gray-900 mb-2"><%= post.title %></h2>
          <p class="text-gray-600 mb-4 line-clamp-3"><%= post.content %></p>
          <div class="flex justify-between items-center">
            <%= link_to 'Read More', post, class: "text-blue-600 hover:text-blue-800 font-medium" %>
            <div class="space-x-2">
              <%= link_to 'Edit', edit_post_path(post), class: "text-gray-600 hover:text-gray-800" %>
              <%= link_to 'Delete', post, method: :delete, data: { confirm: 'Are you sure?' }, class: "text-red-600 hover:text-red-800" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-12">
      <p class="text-gray-500 text-lg mb-4">No posts yet.</p>
      <%= link_to 'Create your first post', new_post_path, class: "bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition-colors" %>
    </div>
  <% end %>
</div>
