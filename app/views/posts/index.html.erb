<div class="max-w-6xl mx-auto px-4 py-6 sm:py-8">
  <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center mb-6 sm:mb-8 space-y-4 sm:space-y-0">
    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900">Posts</h1>
    <%= link_to 'New Post', new_post_path, class: "w-full sm:w-auto bg-blue-600 text-white px-4 sm:px-6 py-2 rounded-lg hover:bg-blue-700 transition-colors text-center font-medium" %>
  </div>

  <% if @posts.any? %>
    <div class="grid gap-4 sm:gap-6 grid-cols-1 lg:grid-cols-2 xl:grid-cols-3">
      <% @posts.each do |post| %>
        <div class="bg-white rounded-lg shadow-md p-4 sm:p-6 hover:shadow-lg transition-shadow">
          <h2 class="text-lg sm:text-xl font-semibold text-gray-900 mb-2 line-clamp-2"><%= post.title %></h2>
          <p class="text-gray-600 mb-4 line-clamp-3 text-sm sm:text-base"><%= post.content %></p>
          <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center space-y-2 sm:space-y-0">
            <%= link_to 'Read More', post, class: "text-blue-600 hover:text-blue-800 font-medium text-sm sm:text-base" %>
            <div class="flex space-x-2 sm:space-x-3">
              <%= link_to 'Edit', edit_post_path(post), class: "text-gray-600 hover:text-gray-800 text-sm sm:text-base" %>
              <%= link_to 'Delete', post, method: :delete, data: { confirm: 'Are you sure?' }, class: "text-red-600 hover:text-red-800 text-sm sm:text-base" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-8 sm:py-12">
      <svg class="w-12 h-12 sm:w-16 sm:h-16 mx-auto mb-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
      </svg>
      <p class="text-gray-500 text-base sm:text-lg mb-4">No posts yet.</p>
      <%= link_to 'Create your first post', new_post_path, class: "inline-block bg-blue-600 text-white px-4 sm:px-6 py-2 sm:py-3 rounded-lg hover:bg-blue-700 transition-colors font-medium" %>
    </div>
  <% end %>
</div>
