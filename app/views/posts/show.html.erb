<div class="max-w-4xl mx-auto px-4 py-8">
  <div class="bg-white rounded-lg shadow-md p-8">
    <div class="flex justify-between items-start mb-6">
      <h1 class="text-3xl font-bold text-gray-900"><%= @post.title %></h1>
      <div class="space-x-2">
        <%= link_to 'Edit', edit_post_path(@post), class: "bg-gray-600 text-white px-4 py-2 rounded-lg hover:bg-gray-700 transition-colors" %>
        <%= link_to 'Delete', @post, method: :delete, data: { confirm: 'Are you sure?' }, class: "bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition-colors" %>
      </div>
    </div>
    
    <div class="prose max-w-none">
      <p class="text-gray-700 whitespace-pre-wrap"><%= @post.content %></p>
    </div>
    
    <div class="mt-8 pt-6 border-t border-gray-200">
      <%= link_to '← Back to Posts', posts_path, class: "text-blue-600 hover:text-blue-800 font-medium" %>
    </div>
  </div>
</div>
