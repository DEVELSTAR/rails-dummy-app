<div class="max-w-4xl mx-auto px-4 py-6 sm:py-8">
  <div class="bg-white rounded-lg shadow-md p-4 sm:p-6 lg:p-8">
    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start mb-6 space-y-4 sm:space-y-0">
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 pr-4"><%= @post.title %></h1>
      <div class="flex flex-col sm:flex-row space-y-2 sm:space-y-0 sm:space-x-2">
        <%= link_to 'Edit', edit_post_path(@post), class: "w-full sm:w-auto bg-gray-600 text-white px-4 py-2 rounded-lg hover:bg-gray-700 transition-colors text-center font-medium text-sm sm:text-base" %>
        <%= link_to 'Delete', @post, data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' }, class: "w-full sm:w-auto bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition-colors text-center font-medium text-sm sm:text-base" %>
      </div>
    </div>
    
    <div class="prose max-w-none">
      <p class="text-gray-700 whitespace-pre-wrap text-sm sm:text-base leading-relaxed"><%= @post.content %></p>
    </div>
    
    <div class="mt-6 sm:mt-8 pt-4 sm:pt-6 border-t border-gray-200">
      <%= link_to '← Back to Posts', posts_path, class: "text-blue-600 hover:text-blue-800 font-medium text-sm sm:text-base inline-flex items-center" %>
    </div>
  </div>
</div>
